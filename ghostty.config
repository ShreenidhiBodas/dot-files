# font-family = "UbuntuMono Nerd Font"
# font-family = "Menlo"
font-family = "PlemoJP Console NF"
font-size = 14
font-thicken = true
font-thicken-strength = 70
# theme = vesper
theme = Solarized-Vivid
background-opacity = 0.85
background-blur = 16


# Keybindings 
# Create splits
keybind = super+shift+h=new_split:left
keybind = super+shift+j=new_split:down
keybind = super+shift+k=new_split:up
keybind = super+shift+l=new_split:right

# pane focus Keybindings
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right

# pane resize
keybind = alt+shift+h=resize_split:left,10
keybind = alt+shift+j=resize_split:down,10
keybind = alt+shift+k=resize_split:up,10
keybind = alt+shift+l=resize_split:right,10

# Edit ghostty config through nvim
keybind = super+,=text:ghostty +edit-config\n

# Guake style terminal
# # Toggle from anywhere with Cmd + `
keybind = global:cmd+\=toggle_quick_terminal

# Optional: make it occupy 65% of the screen height
quick-terminal-size = 65%

# Optional: faster slide animation
quick-terminal-animation-duration = 0.12

